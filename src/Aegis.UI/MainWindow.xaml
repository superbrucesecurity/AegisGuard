<Window x:Class="Aegis.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AEGIS Guard" Height="860" Width="1400" MinHeight="640" MinWidth="1000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="#080B12" CornerRadius="14" BorderBrush="#1C2638" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0B101A" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_Drag">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="8" Background="#123A4A" Margin="0,0,10,0">
                            <Path Data="M13 2 L21 5 V11 C21 16 18 20 13 23 C8 20 5 16 5 11 V5 Z"
                                  Stroke="#39E6C3" StrokeThickness="1.6" Fill="#0C2730"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AEGIS GUARD" Foreground="#E8F4F2" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="/ next-generation protection" Foreground="#62748D" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="40" Height="30" Content="─" Foreground="#9FB0C6" Background="Transparent" BorderThickness="0" FontSize="16" Click="Minimize_Click" />
                        <Button Width="40" Height="30" Content="□" Foreground="#9FB0C6" Background="Transparent" BorderThickness="0" FontSize="14" Click="Maximize_Click" />
                        <Button Width="44" Height="30" Content="✕" Foreground="#9FB0C6" Background="Transparent" BorderThickness="0" FontSize="14" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <wv2:WebView2 x:Name="Browser" Grid.Row="1" DefaultBackgroundColor="#080B12" />

            <Border Grid.Row="2" Background="#0B101A" CornerRadius="0,0,14,14">
                <Grid Margin="16,0">
                    <TextBlock x:Name="StatusText" Text="Conectando con el motor local..." Foreground="#71839B" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="AEGIS Guard · protección multicapa" Foreground="#4A5A70" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
